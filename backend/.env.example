# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Number of trusted reverse-proxy hops in front of Express (Next.js rewrite,
# Vercel, ALB, nginx). MUST be non-zero in any deployment where traffic arrives
# through a proxy: otherwise req.ip is the proxy's address and every client shares
# one rate-limit bucket, so five bad logins from anyone lock out the whole
# deployment for 15 minutes.
TRUST_PROXY_HOPS=0

# Database
DATABASE_URL=postgresql://photos:photos_dev@localhost:5432/photos?connection_limit=20

# Redis
# NOTE: Redis is consulted before Postgres when validating a session, so it must
# not be reachable from untrusted networks. Bind it to localhost and set a
# password.
REDIS_URL=redis://localhost:6379

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=photos-platform

# Public CloudFront domain for derived image variants, e.g.
# https://dxxxxxxxx.cloudfront.net
# When set, thumbnails/web/crops are served straight from the CDN. Originals are
# never served this way: the distribution has no signed URLs, so anything reachable
# through it is world-readable to anyone holding the URL, and edge-cached copies
# cannot be revoked. Leave empty to serve everything via short-lived presigned URLs.
CDN_BASE_URL=

# ─── Auth ────────────────────────────────────────────────────────────────────
# The single shared password for the whole application. REQUIRED, minimum 12
# characters.
APP_PASSWORD=

# Signs session entries in the Redis cache so a forged cache entry cannot mint a
# session. REQUIRED, minimum 32 characters. Generate with:
#   openssl rand -hex 32
SESSION_SIGNING_SECRET=

SESSION_TTL_DAYS=30

# ─── Worker ──────────────────────────────────────────────────────────────────
WORKER_URL=http://localhost:8001

# Shared secret for the /internal service surface, which can presign object URLs
# and mutate media rows. REQUIRED, minimum 32 characters. The worker reads this
# same variable name, so one value configures both services. Generate with:
#   openssl rand -hex 32
# There is no "unset means disabled" mode: an empty value used to disable auth on
# the entire internal surface, which the old example file shipped by default.
WORKER_SECRET=

# ─── Upload ──────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=5000
PRESIGNED_URL_EXPIRY_SECONDS=900

# ─── Search ──────────────────────────────────────────────────────────────────
# CLIP semantic search requires the worker to be reachable at WORKER_URL. When
# false, search uses Postgres full-text and honestly reports searchType 'fts'
# rather than claiming 'semantic'.
SEMANTIC_SEARCH_ENABLED=false
HNSW_EF_SEARCH=100

# ─── Logging ─────────────────────────────────────────────────────────────────
# One of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
