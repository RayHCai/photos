# Copy to terraform.tfvars (gitignored) and fill in.

bucket_name = "photos-platform"
aws_region  = "us-east-1"

# Required — no default. The previous default hard-coded a real production hostname
# into version control.
cors_origins = [
  "http://localhost:3000",
  "https://photos.example.com",
]

# How long a deleted photo's object version is retained before permanent deletion.
noncurrent_version_retention_days = 30
