# Terraform remote state configuration.
#
# Copy to backend.hcl (gitignored) and run:
#   terraform init -backend-config=backend.hcl
#
# The bucket must exist before the first init, and should have versioning enabled so
# a corrupted or truncated state can be rolled back. State contains the IAM secret
# key in plaintext, so it must never be a public bucket.
bucket = "your-terraform-state-bucket"
region = "us-east-1"
