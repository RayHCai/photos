# Frontend environment variables. Copy to .env.local and fill in.
# Only NEXT_PUBLIC_* vars are exposed to the browser (inlined at build time).

# Base path/URL for the backend API.
NEXT_PUBLIC_API_URL=/api/v1

# Server-only: where the Next.js server proxies API calls during SSR.
API_INTERNAL_URL=http://localhost:4000

# Public CloudFront domain for the image CDN, e.g. https://dxxxxxxxx.cloudfront.net
# (the aws_cloudfront_distribution.thumbnails domain_name output from infra/main.tf).
# When set, the gallery builds thumbnail/web URLs directly from each item's stored
# key — no /media/thumbnail-urls batch round-trip and no per-item /thumbnail 302.
# Leave empty to fall back to the presigned-mode redirect endpoints.
NEXT_PUBLIC_CDN_BASE_URL=
