# Worker configuration.
#
# Every value below mirrors the default in src/worker/config.py. Do not change a
# tuning value here without meaning to: pydantic-settings loads .env and it
# overrides the code default. This file previously shipped face thresholds that
# silently contradicted the code — making recognition stricter, which over-splits
# one person into several duplicates — and nothing logged the effective values, so
# the drift was invisible.

REDIS_URL=redis://localhost:6379
BACKEND_URL=http://localhost:4000
WORKER_PORT=8001

# Shared secret for the backend <-> worker internal API. REQUIRED, minimum 32
# characters, and must be the same value as the backend's WORKER_SECRET (the worker
# reads that same variable name, so one value configures both). Generate with:
#   openssl rand -hex 32
# There is no "unset means disabled" mode any more: both services refuse to boot
# without it, because an empty value used to disable auth on the entire internal
# surface.
WORKER_SECRET=

# ─── Models ──────────────────────────────────────────────────────────────────
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=openai

# ─── Face detection / assignment ─────────────────────────────────────────────
# Detector score floor.
FACE_DET_THRESH=0.6
# Detections below this are discarded entirely.
FACE_CONFIDENCE_THRESH=0.72
# A face matching nobody needs at least this confidence to justify creating a new
# person.
FACE_NEW_PERSON_THRESH=0.87
# DISTANCE threshold: a face matches an existing person when distance < this.
# Lower is STRICTER and over-splits one person into several.
FACE_MATCH_THRESH=0.55
# Minimum face box size in pixels; below this, embeddings are unreliable.
FACE_MIN_SIZE=50

# ─── Resources ───────────────────────────────────────────────────────────────
# Concurrent media jobs. CPU stages run in a thread pool sized from this, so it
# also bounds peak decoded-image memory. Raise only with RAM headroom to match.
MEDIA_CONCURRENCY=3
# Decompression-bomb guard: refuse images with more decoded pixels than this.
MAX_IMAGE_PIXELS=120000000

# ─── Reverse geocoding (opt-in) ──────────────────────────────────────────────
# OFF by default because it sends photo GPS coordinates — rounded only to ~111m,
# i.e. house level — to a third party. Enable only deliberately, and prefer
# pointing GEOCODE_PROVIDER_URL at a self-hosted Nominatim.
GEOCODING_ENABLED=false
GEOCODE_PROVIDER_URL=https://nominatim.openstreetmap.org/reverse
# Nominatim's usage policy requires a real contact address here.
GEOCODE_USER_AGENT=photos-app/1.0 (you@example.com)

# ─── Logging ─────────────────────────────────────────────────────────────────
# One of: critical, error, warning, info, debug, notset
LOG_LEVEL=info
